# Copy to .env (never commit it) and fill in your keys to run the real-API tests:
#   uv run pytest -m integration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# OpenAI-compatible check through OpenRouter (several model families, one key).
OPENROUTER_API_KEY=

# Optional: cheaper/other models for the integration tests.
# CAELUM_IT_OPENAI_MODEL=gpt-4o-mini
# CAELUM_IT_ANTHROPIC_MODEL=claude-haiku-5-5
# CAELUM_IT_GEMINI_MODEL=gemini-3.1-flash-lite
# CAELUM_IT_MISTRAL_MODEL=mistral-small-latest
